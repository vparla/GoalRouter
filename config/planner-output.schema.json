{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/goalrouter/planner-output.schema.json",
  "title": "GoalRouter structured planner output",
  "type": "object",
  "additionalProperties": false,
  "required": ["work-items"],
  "properties": {
    "work-items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/work-item"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "work-item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "instructions",
        "task",
        "phase",
        "dependencies",
        "access",
        "affected-paths",
        "expected-result",
        "verification",
        "confidence",
        "risk-flags"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "title": {"type": "string", "minLength": 1},
        "instructions": {"type": "string", "minLength": 1},
        "task": {"$ref": "#/$defs/identifier"},
        "phase": {"$ref": "#/$defs/identifier"},
        "dependencies": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true
        },
        "access": {"enum": ["read-only", "workspace-write"]},
        "affected-paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "expected-result": {"type": "string", "minLength": 1},
        "verification": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "risk-flags": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true
        }
      }
    }
  }
}
